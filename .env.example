# Copy to .env and fill in. Never commit the real .env.

# ---- server ----
NODE_ENV=development
# Binds to loopback by default. Container/PaaS deploys set HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8080

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_HOURS=12

# SQLite location. Point this at a mounted volume in production.
DATA_DIR=./data
# DB_PATH=./data/disruption.sqlite

# ---- first login ----
# Created automatically on first boot while the users table is empty.
# Alternative: npm run seed -- <email> "<name>" <password> admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Google Sheet master data ----
# Preferred for a privately shared sheet: a read-only service account with the
# sheet shared to its client_email. Paste the whole JSON key on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or point at a key file instead:
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/service-account.json
#
# Without either, the app falls back to Google's public CSV export, which needs
# the sheet shared as "anyone with the link can view".

# Optional overrides for config/app.config.json (handy when the id is a secret).
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
SYNC_INTERVAL_MINUTES=7
SYNC_ON_BOOT=true
